# Rojo / Studio build outputs (regenerate with `rojo build` / `rojo sourcemap`)
build.rbxlx
release.rbxlx
sourcemap.json
rojo-serve*.log
*.rbxl.lock
*.rbxlx.lock

# Raw download archives duplicate the unpacked CC0 sources stored beside them;
# assets/third_party/poly_pizza/README.md lists each original download page.
assets/**/source.zip

# Owner's model-quality reference images: web images with an unknown licence, kept
# local because the repository is public (docs/art/quality-reference/README.md).
docs/art/quality-reference/*.png
docs/art/quality-reference/*.jpg
docs/art/quality-reference/*.webp

# Art pipeline (CM2-AP): generated builds, probe output and Blender backups. The art
# .blend files under assets/art/source are committed; the generated probe .blend is not.
assets/art/_build/
tests/fixtures/art/_build/
tests/fixtures/art/rbxm/
tests/fixtures/art/source/**/*.blend
*.blend1
__pycache__/

# Swarve Essential UI Pack: licensed for use, not for redistribution
assets/third_party/swarve-essential-ui/*.rbxl
assets/third_party/swarve-essential-ui/*.rbxlx
