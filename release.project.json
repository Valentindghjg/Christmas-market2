{
  "name": "ChristmasMarket2",
  "globIgnorePaths": ["src/server/Services/StudioTestService.lua"],
  "tree": {
    "$className": "DataModel",
    "Workspace": {
      "$className": "Workspace",
      "$properties": {
        "StreamingEnabled": true
      }
    },
    "Lighting": {
      "$className": "Lighting",
      "$properties": {
        "Technology": "Future",
        "GlobalShadows": true,
        "ShadowSoftness": 0.25,
        "Brightness": 2.2,
        "EnvironmentDiffuseScale": 0.6,
        "EnvironmentSpecularScale": 0.4,
        "Ambient": [0.3529, 0.3725, 0.4314],
        "OutdoorAmbient": [0.5882, 0.5686, 0.549],
        "ExposureCompensation": -0.15
      },
      "CM2Atmosphere": {
        "$className": "Atmosphere",
        "$properties": {
          "Density": 0.25,
          "Offset": 0.2,
          "Color": [0.8706, 0.8941, 0.9333],
          "Decay": [0.6667, 0.7451, 0.8431],
          "Glare": 0.4,
          "Haze": 1.2
        }
      },
      "CM2ColorCorrection": {
        "$className": "ColorCorrectionEffect",
        "$properties": {
          "Brightness": 0.02,
          "Contrast": 0.12,
          "Saturation": 0.22,
          "TintColor": [1.0, 0.9569, 0.902]
        }
      },
      "CM2Bloom": {
        "$className": "BloomEffect",
        "$properties": {
          "Intensity": 0.3,
          "Size": 24,
          "Threshold": 1.3
        }
      },
      "CM2SunRays": {
        "$className": "SunRaysEffect",
        "$properties": {
          "Intensity": 0.08,
          "Spread": 0.6
        }
      }
    },
    "ReplicatedStorage": {
      "$className": "ReplicatedStorage",
      "Shared": {
        "$path": "src/shared"
      },
      "ArtAssets": {
        "$path": "assets/art/rbxm"
      }
    },
    "ServerScriptService": {
      "$className": "ServerScriptService",
      "Server": {
        "$path": "src/server"
      }
    },
    "ServerStorage": {
      "$className": "ServerStorage"
    },
    "StarterPlayer": {
      "$className": "StarterPlayer",
      "StarterPlayerScripts": {
        "$className": "StarterPlayerScripts",
        "Client": {
          "$path": "src/client"
        }
      }
    }
  }
}
